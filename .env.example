# 复制为 .env 并填写真实值（.env 已 gitignore，不会提交）
# 部署鉴权（wrangler 用）
CLOUDFLARE_EMAIL=you@example.com
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=cfut_your_api_token_here

# Worker 运行时环境变量（非敏感可配；敏感值请用 `wrangler secret put`）
# UPSTREAM_URL=https://api.cline.bot/api/v1/chat/completions
# MODELS_UPSTREAM=https://api.cline.bot/api/v1/ai/cline/recommended-models
# CLINE_API_KEY=sk-your-cline-key